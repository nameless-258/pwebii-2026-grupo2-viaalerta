# Copiar para .env e preencher. NUNCA fazer commit do ficheiro .env.
# Sem estas variáveis a aplicação arranca em "modo demonstração" (dados guardados no navegador).

# Supabase (Project Settings → API). A anon key é pública por desenho; a segurança está nas políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (https://dashboard.emailjs.com). Chave pública + IDs do serviço e do modelo.
# Limitar os domínios autorizados ao vosso GitHub Pages no painel do EmailJS.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
